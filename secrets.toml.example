# Salin file ini menjadi  .streamlit/secrets.toml  (JANGAN di-upload ke GitHub)
# Di Streamlit Cloud: Manage app > Settings > Secrets, lalu tempel isinya.

[sheets]
spreadsheet_id = "ISI_ID_SPREADSHEET"   # bagian di URL: docs.google.com/spreadsheets/d/<ID>/edit
worksheet = "checklist"                  # nama tab; dibuat otomatis jika belum ada

# Isi bagian di bawah dari file JSON service account (Google Cloud)
[gcp_service_account]
type = "service_account"
project_id = "..."
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "nama@project-id.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."
universe_domain = "googleapis.com"
